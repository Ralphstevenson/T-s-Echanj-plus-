/* ==========================================
   KONTENÈ PRENSIPAL PAJ AKÈY
   ========================================== */
.akey-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 20px;
}

/* ==========================================
   1. CAROUSEL DESIGN
   ========================================== */
.carousel-section {
    position: relative;
    width: 100%;
    height: 150px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.carousel-track {
    width: 100%;
    height: 100%;
}

.carousel-slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.carousel-slide.active {
    opacity: 1;
    visibility: visible;
}

.slide-content {
    height: 100%;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: white;
}

/* Gradiyan pou Slide yo */
.grad-blue { background: linear-gradient(135deg, #0061ff, #60efff); }
.grad-purple { background: linear-gradient(135deg, #667eea, #764ba2); }
.grad-green { background: linear-gradient(135deg, #11998e, #38ef7d); }

.slide-info h3 {
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.slide-info p {
    font-size: 0.85rem;
    opacity: 0.9;
    max-width: 180px;
}

.slide-icon {
    font-size: 3.5rem;
    opacity: 0.25;
}

/* Endikatè Carousel */
.carousel-indicators {
    position: absolute;
    bottom: 12px;
    left: 20px;
    display: flex;
    gap: 6px;
}

.dot {
    width: 6px;
    height: 6px;
    background: rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    transition: 0.3s;
}

.dot.active {
    background: white;
    width: 18px;
    border-radius: 10px;
}

/* ==========================================
   2. KAT BALANS (PREMIUM)
   ========================================== */
